<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug builds only. A token minted under this entitlement is deliverable
	     via api.sandbox.push.apple.com and is rejected by the production host,
	     so the app registers it as 'sandbox'. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
