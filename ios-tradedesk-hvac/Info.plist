<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Only the keys that cannot be expressed as INFOPLIST_KEY_* build settings
	  live here. CFBundleURLTypes is an array of dictionaries, which that
	  mechanism cannot represent, so this partial file is merged with the
	  generated Info.plist (GENERATE_INFOPLIST_FILE stays YES).

	  This registers the scheme Supabase auth emails redirect back to, and the
	  location background mode. It does not change the bundle identifier or any
	  signing setting.
	-->
	<!--
	  Location background mode.

	  Required so an engineer's position keeps reaching the office while they are
	  driving with the phone locked. It is used for exactly one thing: the leg
	  between "Start travel" and "Arrived". CoreLocationService sets
	  allowsBackgroundLocationUpdates only for the duration of that leg and clears
	  it the moment the leg ends, so a suspended app holds no location assertion.
	  showsBackgroundLocationIndicator stays on throughout, so the worker can
	  always see the app is reading their position.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<!--
	  Harbour South's published privacy policy. Empty until the real public
	  https URL exists: put it here and every in-app Privacy Policy entry point
	  opens it (Brand.privacyPolicyURL). Never an invented address.
	-->
	<key>HarbourSouthPrivacyPolicyURL</key>
	<string></string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.harboursouth.fieldservice.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.harboursouth.fieldservice</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
